@page
@model ProjectorModel
@{
    ViewData["Title"] = "Daniel fyller 40 — Projektor";
    Layout = "_Layout";
}

@section Styles {
    <style>
                                        body {
                                            overflow: hidden;
                                            background: #0a0a1a;
                                        }
    </style>
}

<div class="projector-page">

    @* Titelrad *@
    <div class="projector-header">
        <span>Daniel fyller 40!</span>
        <div class="projector-header-actions">
            <button type="button" class="projector-slideshow-toggle" id="projector-slideshow-toggle"
                    title="Starta bildspel">Bildspel</button>
            <form method="post" asp-page-handler="Logout">
                <button type="submit" class="btn-logout proj-logout">Logga ut</button>
            </form>
        </div>
    </div>

    @* Räknare i projektor-läge *@
    <div class="projector-counters">
        <div class="proj-counter">
            <span class="proj-counter-icon">✨</span>
            <span>Ord: <strong><span id="proj-words">@Model.UnlockedWords</span>/@Model.TotalWords</strong></span>
        </div>
        <div class="proj-counter">
            <span class="proj-counter-icon">🔥</span>
            <span>Kombos: <strong><span id="proj-combos">@Model.UnlockedCombos</span>/@Model.TotalCombos</strong></span>
        </div>
        <div class="proj-counter">
            <span class="proj-counter-icon">👥</span>
            <span>Deltagare: <strong><span id="proj-participants">–</span></strong></span>
        </div>
    </div>

    @* Projektorlayout: användare (vänster), chatt (mitten), info (höger) *@
    <div class="projector-feed" id="projector-feed">
        <div class="projector-columns" id="projector-columns">
            <section class="projector-panel projector-panel-users">
                <h2 class="projector-panel-title">Inloggade</h2>
                <div class="projector-user-list" id="proj-user-list"></div>
            </section>

            <section class="projector-panel projector-panel-history">
                <h2 class="projector-panel-title">Chatt</h2>
                <div class="projector-chat-list" id="projector-chat-list"></div>
            </section>

            <section class="projector-panel projector-panel-info">
                <h2 class="projector-text-headline">@Model.ProjectorHeadline</h2>
                <p class="projector-text-sub">@Model.ProjectorSubtext</p>

                <div class="projector-total-messages">
                    Totalt antal meddelanden
                    <strong id="proj-total-messages">@Model.TotalMessages</strong>
                </div>

                <div class="projector-hourly-chart" aria-label="Meddelanden senaste 12 timmarna">
                    <div class="projector-hourly-chart-title">Meddelanden senaste 12 timmarna</div>
                    <div class="projector-hourly-bars" id="proj-hourly-bars"></div>
                </div>

                <div class="projector-latest-vma">
                    <div class="projector-hourly-chart-title">Senaste VMA</div>
                    <div class="projector-latest-vma-text" id="proj-latest-vma">
                        @(string.IsNullOrWhiteSpace(Model.LatestVmaMessage) ? "Inget VMA ännu" : Model.LatestVmaMessage)
                    </div>
                </div>
            </section>
        </div>

        <div class="projector-slideshow" id="projector-slideshow" hidden>
            <div class="projector-slideshow-stage">
                <img id="projector-slideshow-image" alt="Bildspel" />
            </div>
            <div class="projector-slideshow-caption" id="projector-slideshow-caption"></div>
        </div>
    </div>

    @* Triggeranimations-overlay *@
    <div id="trigger-overlay" class="trigger-overlay" style="display:none">
        <div id="trigger-popup" class="trigger-popup projector-popup"></div>
    </div>

</div>

@section Scripts {
    <script>
                                            const TRIGGER_WORDS = @Html.Raw(Model.WordsJson);
                                            const UNLOCKED_WORDS = new Set(@Html.Raw(Model.UnlockedWordSetJson));
                                            const HOURLY_MESSAGE_COUNTS = @Html.Raw(Model.HourlyMessageCountsJson);
    </script>
    <script src="~/js/projector.js" asp-append-version="true"></script>
}