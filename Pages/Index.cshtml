@page
@model IndexModel
@{
    ViewData["Title"] = "Danne fyller 40!";
    Layout = "_Layout";
}

<div class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <img src="~/images/face.png" alt="Daniel" class="login-face" />
        </div>
        <h1>Danne fyller 40!</h1>
        @* <p class="login-subtitle">Välkommen till festen — skriv lösenordet för att komma in.</p> *@

        @if (Model.ErrorMessage != null)
        {
            <div class="error-box">@Model.ErrorMessage</div>
        }

        <form method="post">
            <div class="form-group">
                <label for="username">Namn </label>
                <input type="text" id="username" name="Username" class="form-input" maxlength="20"
                       value="@Model.SavedName" autocomplete="off" />
            </div>

            <div class="form-group">
                <label for="password">Lösenord</label>
                <input type="password" id="password" name="Password" class="form-input" autocomplete="off" required />
            </div>
            <button type="submit" class="btn-primary">Logga in</button>
        </form>
    </div>
</div>