@page
@model IndexModel
@{
    ViewData["Title"] = "Daniel fyller 40!";
    Layout = "_Layout";
}

<div class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <img src="~/images/face.png" alt="Daniel" class="login-face" />
        </div>
        <h1>Daniel fyller 40!</h1>
        @* <p class="login-subtitle">Välkommen till festen — skriv lösenordet för att komma in.</p> *@

        @if (Model.ErrorMessage != null)
        {
            <div class="error-box">@Model.ErrorMessage</div>
        }

        <form method="post">
            <div class="form-group">
                <label for="username">Namn </label>
                <div class="username-avatar-row">
                    <input type="text" id="username" name="Username" class="form-input" maxlength="20"
                           value="@Model.SavedName" autocomplete="nickname" autocorrect="off" spellcheck="false" />
                    <button type="button" id="login-avatar-btn" class="login-avatar-btn"
                            title="Klicka för att slumpa ny avatar">
                        <img id="login-avatar-preview" class="login-avatar-preview" src="" alt="Din avatar" />
                    </button>
                </div>
                <div class="avatar-inline-hint">Klicka på avataren för att slumpa en ny</div>
                <input type="hidden" id="avatar-id" name="AvatarId" />
            </div>

            <div class="form-group">
                <label for="password">Lösenord</label>
                <input type="password" id="password" name="Password" class="form-input" autocomplete="current-password"
                       required />
            </div>
            <button type="submit" class="btn-primary">Logga in</button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/login-avatar.js" asp-append-version="true"></script>
}